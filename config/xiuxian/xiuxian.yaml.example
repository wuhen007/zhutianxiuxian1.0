# 修仙主配置模板（脱敏）
#
# 用法：复制成同目录下的 xiuxian.yaml 再按实际修改。
#
#   cp config/xiuxian/xiuxian.yaml.example config/xiuxian/xiuxian.yaml
#
# 注意：
#   1. 插件启动时读取的是 xiuxian.yaml，缺这个文件会直接报错停止加载
#      （见 model/Config.js：主配置缺失时不做默认初始化）。
#   2. 真实配置文件里含群号、主人 QQ，已从仓库排除，不要把它提交上来。
#   3. 下面所有群号 / QQ / openid 都是占位值，照抄跑不通，必须换成自己的。
#   4. SecretPlace.one/two/three 必须是 0~1 的数值；
#      Auction.Auction_task、Auction2.Auction_task、AutoDailyTask.cron 必须是非空 cron 字符串，
#      否则加载时会被校验拦下。

CD:
  association: 10080
  joinassociation: 450
  associationbattle: 1440
  rob: 1
  gambling: 3
  couple: 60
  garden: 3
  level_up: 0
  secretplace: 7
  xiajie: 10
  timeplace: 7
  forbiddenarea: 7
  reborn: 1440
  transfer: 240
  honbao: 1
  stone_market: 360
percentage:
  cost: 0.03
  Monezsawe#number: 1
  punishment: 0.5
  stone_rewards:
    pure_source: 2
    special_source: 5
    god_source: 10
    ancient_herb: 20
    sacred_fragment: 50
    emperor_page: 100
size:
  Money: 200
switch:
  play: true
  Moneynumber: true
  couple: true
  Xiuianplay_key: true
  StoneMarket: true
  # 是否强制玩家先完成官方 Bot 绑定才能玩
  requireQQBotBind: false
StoneMarket:
  stone_levels:
    - name: 普通源石
      price: 50000
      quality: 1
    - name: 精品源石
      price: 200000
      quality: 2
    - name: 神源石
      price: 1000000
      quality: 3
  win_rate:
    base: 0.2
    master_bonus: 0.3
    grandmaster_bonus: 0.5
    godstone_bonus: 0.2
  ban:
    high_reward_threshold: 3
    duration: 24
biguan:
  size: 10
  time: 30
  cycle: 240
work:
  size: 15
  time: 15
  cycle: 48
Sign:
  ticket: 1
Auction:
  interval: 2
  openHour: 20
  closeHour: 21
  Auction_task: 0 0/1 * * * ?
Auction2:
  interval: 2
  openHour: 21
  closeHour: 23
  Auction_task: 0 0/1 * * * ?
SecretPlace:
  one: 0.99
  two: 0.5
  three: 0.25
najie_num:
  - 50000
  - 100000
  - 200000
  - 500000
  - 1000000
  - 2000000
  - 5000000
  - 10000000
najie_price:
  - 0
  - 50000
  - 100000
  - 500000
  - 500000
  - 1000000
  - 3000000
  - 6000000
# 允许玩修仙的群（协议号视角的数字群号）
Group:
  - 100000000
Era:
  enabled: true
  # 纪元推进的 cron
  task: 0 0 */1 * * *
  pushNotice: true
  # 纪元/灾劫等全服公告的推送目标。
  # 可以写数字群号（走协议号），也可以写官方群的 group_openid（32 位十六进制）。
  # 同一个群只写一种，群号和它的 openid 同时出现会导致每条公告发两遍。
  notifyGroups:
    - "100000000"
  # 纪元主掌人 QQ，null 表示无
  Master: null
  # 当前纪元进度；新服从 0 开始，不要照抄别人的进度
  current:
    index: 0
    years: 0
    epoch: 0
    totalYears: 0
  yearlyAdvance: 1000
  weimianRepairInterval: 2000
  # 域外天灾的自然推进年数，同样从 0 开始
  foreignCalamityNaturalYears: 0
# onebot = 协议号；official = 官方 Bot 通道
BotType: onebot
AutoDailyTask:
  cron: 0 0 18 * * *
# 群主在本群授予的管理员：{ "<管理员QQ>": ["<生效群号>", ...] }
# 留空 `{}` 表示没有群级管理员
MasterScoped: {}
